/*
 * Assign the onboard RAK4631 SX1262 to usp_zephyr.
 *
 * The board DTS already defines &lora (SPI, reset, and busy) and the lora0 alias.
 * The local compatibility include changes its compatible to
 * "semtech,sx1262-new" for the currently pinned USP driver.
 *
 * Replace the credentials under zephyr,user before joining a network.
 */

/* Remove this include when the pinned BSP and USP driver interoperate directly. */
#include "rak4631_usp_compat.dtsi"

/ {
	chosen {
		/* USP threads and HAL locate the radio through this chosen node. */
		zephyr,lorawan-transceiver = &lora;

		/* Route logs through USB CDC; the board default is uart1. */
		zephyr,console = &cdc_acm_uart0;
	};

	aliases {
		/* The board defines only the blue led0; expose the green LED as led1. */
		led1 = &green_led;
	};

	/*
	 * zephyr,user is a standard Zephyr application-data node.
	 * The user-lorawan-* properties form the RZI application credential contract.
	 */
	zephyr,user {
		/* ChirpStack device RZI_001. */
		user-lorawan-device-eui = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		/* Match this value to the Join EUI configured on the network server. */
		user-lorawan-join-eui = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		/* GenAppKey for remote multicast; passed to LBM set_appkey. */
		user-lorawan-gen_app-key = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
					    0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		/* OTAA AppKey; LoRaWAN 1.0 uses it as the LBM network key. */
		user-lorawan-app-key = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
					0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		/* EU_868, CN_470, AS_923_GRP1, US_915, ... */
		user-lorawan-region = "EU_868";
	};
};

/* Standard Zephyr USB CDC console. */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
